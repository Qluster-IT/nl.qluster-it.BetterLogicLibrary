{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch app on HP2026",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "homey",
      "args": [
        "app",
        "run",
        "--remote"
      ],
      "outputCapture": "std",
      "serverReadyAction": {
        "pattern": "Debugger listening on",
        "action": "startDebugging",
        "name": "Attach to HP2026"
      }
    },
    {
      "name": "Attach to HP2026",
      "type": "node",
      "request": "attach",
      "address": "192.168.1.17",
      "port": 9216,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/app/",
      "restart": true
    },
    {
      "name": "Launch app on HP2023",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "homey",
      "args": [
        "app",
        "run",
        "--remote"
      ],
      "outputCapture": "std",
      "serverReadyAction": {
        "pattern": "Debugger listening on",
        "action": "startDebugging",
        "name": "Attach to HP2023"
      }
    },
    {
      "name": "Attach to HP2023",
      "type": "node",
      "request": "attach",
      "address": "192.168.1.242",
      "port": 9216,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/app/",
      "restart": true
    },
    {
      "name": "Launch app on HP2019",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "homey",
      "args": [
        "app",
        "run"
      ],
      "outputCapture": "std",
      "serverReadyAction": {
        "pattern": "Debugger listening on",
        "action": "startDebugging",
        "name": "Attach to HP2019"
      }
    },
    {
      "name": "Attach to HP2019",
      "type": "node",
      "request": "attach",
      "address": "192.168.1.239",
      "port": 9216,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/"
    },
    {
      "name": "Launch app on Docker",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "homey",
      "args": [
        "app",
        "run"
      ],
      "outputCapture": "std",
      "serverReadyAction": {
        "pattern": "Debugger listening on",
        "action": "startDebugging",
        "name": "Attach to Docker"
      }
    },
    {
      "name": "Attach to Docker",
      "type": "node",
      "request": "attach",
      "address": "0.0.0.0",
      "port": 9229,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/app/",
      "restart": true
    },
    {
      "name": "Select HP2026",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "homey",
      "args": [
        "select",
        "-n",
        "Homey"
      ]
    },
    {
      "name": "Select HP2023",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "homey",
      "args": [
        "select",
        "-n",
        "HP2023"
      ]
    },
    {
      "name": "Select HP2019",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "homey",
      "args": [
        "select",
        "-n",
        "HP2019"
      ]
    }
  ]
}
