        "email": "patrick@i-dev.net"
      },
      {
        "name": "Job Born",
        "email": "jobborn@gmail.com"
      },
      {
        "name": "Arie J. Godschalk",
        "email": "arie@qluster-it.nl"
      }
    ]
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "QlusterIT"
      },
      "patreon": {
        "username": "QlusterIT"
      },
      "githubSponsors": {
        "username": "XeroxQ"
      }
    }
  },
  "homeyCommunityTopicId": 5568,
  "source": "https://bitbucket.org/QlusterIT/nl.qluster-it.BetterLogic/",
  "bugs": {
    "url": "https://bitbucket.org/QlusterIT/nl.qluster-it.BetterLogic/issues"
  },
  "flow": {
    "triggers": [
      {
        "id": "if_variable_changed",
        "title": {
          "en": "A variable changed"
        },
        "hint": {
          "en": "Triggers if a variable value changed."
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "Variable name"
            }
          }
        ]
      },
      {
        "id": "if_variable_set",
        "title": {
          "en": "A variable is set"
        },
        "hint": {
          "en": "Triggers if a variable is set (not necessarily changed)"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "Variable name"
            }
          }
        ]
      },
      {
        "id": "if_number_variable_changed",
        "title": {
          "en": "A number variable changed"
        },
        "hint": {
          "en": "Triggers if a number variable is changed."
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "Variable name"
            }
          },
          {
            "name": "action",
            "type": "dropdown",
            "values": [
              {
                "id": "changed",
                "label": {
                  "en": "min. changed by"
                }
              },
              {
                "id": "increased",
                "label": {
                  "en": "min. increased with"
                }
              },
              {
                "id": "decreased",
                "label": {
                  "en": "min. decreased with"
                }
              }
            ],
            "placeholder": {
              "en": "Select action"
            }
          },
          {
            "name": "amount",
            "type": "number",
            "step": 0.01,
            "placeholder": {
              "en": "Variable name"
            }
          }
        ]
      },
      {
        "id": "if_one_of_variable_changed",
        "title": {
          "en": "One of these variables changed"
        },
        "hint": {
          "en": "Type the variable names seperated by a comma.\nTags will not work in this card."
        },
        "args": [
          {
            "name": "variable",
            "type": "text",
            "placeholder": {
              "en": "Var1, Var2, Var3"
            }
          }
        ]
      },
      {
        "id": "debug_any_variable_changed",
        "title": {
          "en": "Any variable changed (DEBUG)"
        }
      }
    ],
    "conditions": [
      {
        "id": "variable_contains",
        "title": {
          "en": "!{{Text contains|Text does not contain}}"
        },
        "titleFormatted": {
          "en": "[[variable]] contains [[value]]"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "Variable"
            },
            "title": {
              "en": "Variable"
            }
          },
          {
            "name": "value",
            "type": "text",
            "placeholder": {
              "en":"Value (* BLL supported)",
              "nl":"Waarde (* BLL ondersteund)"
            },
            "title":{
              "en":"Value",
              "nl":"Waarde"
            }
          }
        ]
      },
      {
        "id": "variable_starts_with",
        "title": {
          "en": "!{{Text starts with|Text does not start with}}"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "value"
            }
          },
          {
            "name": "value",
            "type": "text",
            "placeholder": {
              "en": "value"
            }
          }
        ]
      },
      {
        "id": "variable_matches_string",
        "title": {
          "en": "!{{Text is exact|Text is not exactly}}"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "value"
            }
          },
          {
            "name": "value",
            "type": "text",
            "placeholder": {
              "en": "value"
            }
          }
        ]
      },
      {
        "id": "variable_matches_number",
        "title": {
          "en": "!{{Number is exact|Number is not exactly}}"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "value"
            }
          },
          {
            "name": "value",
            "type": "number",
            "step": 0.01,
            "placeholder": {
              "en": "value"
            }
          }
        ]
      },
      {
        "id": "variable_greater_than",
        "title": {
          "en": "!{{|not}} greater than"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "value"
            }
          },
          {
            "name": "value",
            "type": "number",
            "step": 0.01,
            "placeholder": {
              "en": "value"
            }
          }
        ]
      },
      {
        "id": "variable_less_than",
        "title": {
          "en": "!{{|not}} less than"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "value"
            }
          },
          {
            "name": "value",
            "type": "number",
            "step": 0.01,
            "placeholder": {
              "en": "value"
            }
          }
        ]
      },
      {
        "id": "variable_is_equal",
        "title": {
          "en": "!{{is true|is false}}"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "value"
            }
          }
        ]
      },
      {
        "id": "expression",
        "title": {
          "en": "Math.js expression !{{is true|is false}}"
        },
        "args": [
          {
            "name": "expression",
            "type": "text",
            "placeholder": {
              "en": "$v1$ > 100 and $v1$ < 200 and $b1$"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_a_variable",
        "title": {
          "en": "Set a variable"
        },
        "titleFormatted": {
          "en": "Set [[variable]] to [[value]]"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "Variable"
            }
          },
          {
            "name": "value",
            "type": "text",
            "placeholder": {
              "en":"Value (* BLL supported)",
              "nl":"Waarde (* BLL ondersteund)"
            },
            "title":{
              "en":"Value",
              "nl":"Waarde"
            }
          }
        ]
      },
      {
        "id": "format_datetime",
        "title": {
          "en": "Format datetime"
        },
        "titleFormatted": {
          "en": "Format [[format]] (optional: [[date]], [[locale]], [[timeZone]])"
        },
        "args": [
          {
            "name": "format",
            "type": "autocomplete",
            "placeholder": {
              "en": "Type your own format or select from the list"
            },
            "title": {
              "en": "Date"
            }
          },
          {
            "name": "date",
            "type": "text",
            "required": false,
            "placeholder": {
              "en": "String, Number or Date, or Array of any of those"
            },
            "title": {
              "en": "Date"
            }
          },          
          {
            "name": "locale",
            "type": "autocomplete",
            "required": false,
            "placeholder": {
              "en": "Select a locale from the list"
            },
            "title": {
              "en": "Locale"
            }
          },          
          {
            "name": "timeZone",
            "type": "autocomplete",
            "required": false,
            "placeholder": {
              "en": "Select a timezone from the list"
            },
            "title": {
              "en": "TimeZone"
            }
          }
        ],
        "tokens": [
          {
            "name": "result",
            "type": "string",
            "title": {
              "en": "Formatted result"
            }
          }
        ]
      },
      {
        "id": "execute_bl_expression",
        "title": {
          "en": "Execute BL Expression",
          "nl": "Voer BL expressie uit",
          "de": "BL Bezeichnung setzen"
        },
        "titleFormatted": {
          "en": "Set [[variable]] to [[expression]]",
          "nl": "Zet [[variable]] naar [[expression]]",
          "de": "Setze [[variable]] auf [[expression]]"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "name"
            }
          },
          {
            "name": "expression",
            "type": "text",
            "placeholder": {
              "en": "BL Expression",
              "nl": "BL Expression",
              "de": "BL Bezeichnung"
            }
          }
        ]
      },
      {
        "id": "execute_bl_expression_tag",
        "title": {
          "en": "Execute BL Expression (as Tag)",
          "nl": "Voer BL expressie uit (als Tag)",
          "de": "BL Bezeichnung setzen (als Tag)"
        },
        "titleFormatted": {
          "en": "Execute [[expression]] (as Tag)",
          "nl": "Voer [[expression]] (als Tag)",
          "de": "Führen Sie [[expression]] (als Tag)"
        },
        "args": [          
          {
            "name": "expression",
            "type": "text",
            "placeholder": {
              "en": "BLL Expression",
              "nl": "BLL Expression",
              "de": "BLL Bezeichnung"
            }
          }
        ],
        "tokens": [
          {
            "name": "text",
            "type": "string",
            "title": {
              "en": "Expression value (Text)",
              "nl": "Expressie waarde (Tekst)",
              "de": "Text"
            }
          },
          {
            "name": "number",
            "type": "number",
            "title": {
              "en": "Expression value (Number)",
              "nl": "Expressie waarde (Nummer)",
              "de": "Nummer"
            }
          },
          {
            "name": "boolean",
            "type": "boolean",
            "title": {
              "en": "Expression value (Yes/No)",
              "nl": "Expressie waarde (Ja/Nee)",
              "de": "Ja/Nein"
            }
          }
        ]
      },
      {
        "id": "set_string_variable",
        "title": {
          "en": "Set string variable"
        },
        "titleFormatted": {
          "en": "Set [[variable]] to [[value]]"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "Variable"
            }
          },
          {
            "name": "value",
            "type": "text",
            "placeholder": {
              "en":"Text (* BLL supported)",
              "nl":"Tekst (* BLL ondersteund)"
            },
            "title":{
              "en":"Text",
              "nl":"Tekst"
            }
          }
        ]
      },
      {
        "id": "set_number_variable",
        "title": {
          "en": "Set number variable"
        },
        "titleFormatted": {
          "en": "Set [[variable]] to [[value]]"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "Variable"
            }
          },
          {
            "name": "value",
            "type": "number",
            "step": 0.01,
            "placeholder": {
              "en":"0.01 (* BLL supported)",
              "nl":"0,01 (* BLL ondersteund)"
            },
            "title":{
              "en":"Number",
              "nl":"Nummer"
            }
          }
        ]
      },
      {
        "id": "increment_number_variable",
        "title": {
          "en": "Increment number variable"
        },
        "titleFormatted": {
          "en": "Increment [[variable]] by [[value]]"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "Variable"
            }
          },
          {
            "name": "value",
            "type": "number",
            "step": 0.01,
            "placeholder": {
              "en": "Number"
            }
          }
        ]
      },
      {
        "id": "decrement_number_variable",
        "title": {
          "en": "Decrement number variable"
        },
        "titleFormatted": {
          "en": "Decrement [[variable]] by [[value]]"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "Variable"
            }
          },
          {
            "name": "value",
            "type": "number",
            "step": 0.01,
            "placeholder": {
              "en": "Number"
            }
          }
        ]
      },
      {
        "id": "execute_expression",
        "title": {
          "en": "Execute mathjs expression"
        },
        "args": [
          {
            "name": "expression",
            "type": "text",
            "placeholder": {
              "en": "($n1$ * 42) + 1 (* BLL supported)"
            },
            "title":{
              "en":"Expression",
              "nl":"Expressie"
            }
          },
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "name"
            }
          }
        ]
      },
      {
        "id": "set_boolean_variable",
        "title": {
          "en": "Set boolean variable"
        },
        "titleFormatted": {
          "en": "Set [[variable]] to [[boolean_value]]"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "name"
            }
          },
          {
            "name": "boolean_value",
            "type": "dropdown",
            "values": [
              {
                "id": "true",
                "label": {
                  "en": "True"
                }
              },
              {
                "id": "false",
                "label": {
                  "en": "False"
                }
              }
            ],
            "placeholder": {
              "en":"Yes/No (* BLL supported)",
              "nl":"Ja/Nee (* BLL ondersteund)"
            },
            "title":{
              "en":"Yes/No",
              "nl":"Ja/Nee"
            }
          }
        ]
      },
      {
        "id": "flip_boolean_variable",
        "title": {
          "en": "Flip boolean variable"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "name"
            }
          }
        ]
      },
      {
        "id": "trigger_variable",
        "title": {
          "en": "Execute a trigger"
        },
        "args": [
          {
            "name": "variable",
            "type": "autocomplete",
            "placeholder": {
              "en": "name"
            }
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "bitflip",
      "name": {
        "en": "BitFlip"
      },
      "images": {
        "large": "drivers/bitflip/assets/images/large.jpg",
        "small": "drivers/bitflip/assets/images/small.jpg"
      },
      "class": "socket",
      "capabilities": [
        "onoff"
      ],
      "pair": [
        {
          "id": "list_booleans",
          "template": "list_devices",
          "navigation": {
            "next": "add_booleans"
          }
        },
        {
          "id": "add_booleans",
          "template": "add_devices"
        }
      ]
    },
    {
      "id": "numslide",
      "name": {
        "en": "NumSlide"
      },
      "images": {
        "large": "drivers/numslide/assets/images/large.jpg",
        "small": "drivers/numslide/assets/images/small.jpg"
      },
      "class": "windowcoverings",
      "capabilities": [
        "dim"
      ],
      "mobile": {
        "components": [
          {
            "id": "sensor",
            "capabilities": [
              "dim"
            ],
            "options": {
              "icons": {
                "dim": "./drivers/numslide/assets/icons/icon.svg"
              }
            }
          },
          {
            "id": "slider",
            "capabilities": [
              "dim"
            ]
          }
        ]
      },
      "pair": [
        {
          "id": "start"
        },
        {
          "id": "list_numbers",
          "template": "list_devices",
          "navigation": {
            "next": "add_numbers"
          }
        },
        {
          "id": "add_numbers",
          "template": "add_devices"
        }
      ]
    },
    {
      "id": "trigger",
      "name": {
        "en": "Trigger"
      },
      "images": {
        "large": "drivers/trigger/assets/images/large.jpg",
        "small": "drivers/trigger/assets/images/small.jpg"
      },
      "class": "button",
      "capabilities": [
        "button"
      ],
      "pair": [
        {
          "id": "list_triggers",
          "template": "list_devices",
          "navigation": {
            "next": "add_triggers"
          }
        },
        {
          "id": "add_triggers",
          "template": "add_devices"
        }
      ]
    }
  ],
  "api": {
    "getLibrary": {
      "method": "GET",
      "path": "/library/:library",
      "public": false
    },  
    "decode": {
      "method": "POST",
      "path": "/decode",
      "public": false
    }, 
    "date": {
      "method": "POST",
      "path": "/date",
      "public": false
    },
    "getLocale": {
      "method": "GET",
      "path": "/locale",
      "public": false
    },
    "getLocales": {
      "method": "GET",
      "path": "/locales",
      "public": false
    },
    "getTimeZones": {
      "method": "GET",
      "path": "/timezones",
      "public": false
    },
    "getVariable": {
      "method": "GET",
      "path": "/:variable",
      "public": false
    },
    "triggerVariable": {
      "method": "PUT",
      "path": "/trigger/:variable",
      "public": false
    },
    "setVariableAction": {
      "method": "PUT",
      "path": "/:variable/:action/:value",
      "public": false
    },
    "setVariable": {
      "method": "PUT",
      "path": "/:variable/:value",
      "public": false
    }
  }
}