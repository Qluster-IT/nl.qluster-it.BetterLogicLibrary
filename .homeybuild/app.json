{
  "id": "net.i-dev.betterlogic",
  "version": "2.1.11",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "name": {
    "en": "Better Logic Library"
  },
  "description": {
    "en": "Just some better logic, variable and library management"
  },
  "category": [
    "tools"
  ],
  "tags": {
    "en": ["variable", "bbl", "bl", "coding", "date", "time", "datetime"],
    "nl": ["variabelen", "bbl", "bl", "coding", "datum", "tijd", "datumtijd"]
  },
  "permissions": ["homey:app:net.i-dev.betterlogic"],
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png"
  },
  "brandColor": "#A3DF20",
  "author": {
    "name": "Arie J. Godschalk",
    "email": "arie@qluster-it.nl"
  },
  "contributors": {
    "developers": [
      {
